menu "Smart Home"
    config HOME_UI
        bool "Enable LCD and GT1151 touch home page"
        default y
    config HOME_SIMULATION
        bool "Explicit OFFLINE simulation (never used as USB fallback)"
        default n
        help
            Does not start the two-board USB link. LCD always says SIMULATION.
            Real sensors and load outputs belong exclusively to STM32.
    config HOME_SD_LOG
        bool "Append CSV to inserted FAT microSD every 10 seconds"
        default n
    config HOME_CAMERA
        bool "Optional existing camera probe (outside acceptance scope)"
        select CAMERA_OV3660
        default n
endmenu
