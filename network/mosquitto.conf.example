# Eclipse Mosquitto 2.x, trusted LAN demonstration, MQTT 3.1.1/TCP.
# Copy to mosquitto.conf and edit password_file to your actual absolute path.
listener 1883 0.0.0.0
allow_anonymous false
password_file C:/esp/embedded-smart-home/network/passwd
persistence false
log_type error
log_type warning
log_type notice
log_type information
